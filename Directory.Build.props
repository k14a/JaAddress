<Project>

  <!--
    NuGet パッケージの共通情報。
    既定ではパッケージにせず、配布するプロジェクト（JaAddress.Core / JaAddress.DataBuilder）だけ IsPackable を true にする。
    Version はリリースのたびに更新する。公開ワークフロー（.github/workflows/publish.yml）は、
    タグ（v0.3.0 など）とこの Version が一致しない場合は公開しない。
  -->
  <PropertyGroup>
    <Version>0.3.0</Version>
    <Authors>k14a</Authors>
    <Copyright>Copyright (c) 2026 k14a</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/k14a/JaAddress</PackageProjectUrl>
    <RepositoryUrl>https://github.com/k14a/JaAddress.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/k14a/JaAddress/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- デバッグ用のシンボルパッケージ（.snupkg）と SourceLink -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- CI では、ビルドした環境のパスを含まない決定論的なビルドにする -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
