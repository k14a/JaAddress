# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

csharp_new_line_before_open_brace = never
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_type = false
csharp_new_line_between_query_expression_clauses = false

[*.cs]
# C# コードスタイル: this. の使用を明示
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_property = true:suggestion
dotnet_style_qualification_for_method = true:suggestion
dotnet_style_qualification_for_event = true:suggestion

# var の使用スタイル（好みに応じて調整）
dotnet_style_var_for_built_in_types = true:suggestion
dotnet_style_var_when_type_is_apparent = true:suggestion
dotnet_style_var_elsewhere = false:suggestion

# 名前付け規則（必要に応じて追加）
# dotnet_naming_rule, dotnet_naming_symbols, dotnet_naming_style など

# using の並び順
dotnet_sort_system_directives_first = true

# ファイルスコープ名前空間（C# 10 以降）
csharp_style_namespace_declarations = file_scoped:suggestion

# 中括弧の強制
dotnet_diagnostic.IDE0011.severity = warning

# CA1305: IFormatProvider を指定します
dotnet_diagnostic.CA1305.severity = silent

# Default severity for analyzer diagnostics with category 'Performance'
dotnet_analyzer_diagnostic.category-Performance.severity = silent
