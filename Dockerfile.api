FROM mcr.microsoft.com/dotnet/sdk:10.0-noble@sha256:fe0fd4e93bd2fbb47c883b7a6369e5c8d3db8bf01cdc5981f6ee35fbdf3ff4fb AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/JaAddress.Api/JaAddress.Api.csproj \
    -c Release -o /app/publish --no-self-contained

# 非 root ユーザー（app）で実行される chiseled イメージを使用する
# JaAddress.Core はカルチャ依存の文字列比較を行うため、ICU を含む -extra を使用する
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra@sha256:cae5b962bfb786606def03d250c6a645cc98839095c89e806e4bd8978a68115b
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
ENV JaAddress__DataDirectory=/data

VOLUME /data
EXPOSE 8080
ENTRYPOINT ["dotnet", "JaAddress.Api.dll"]
